#!/bin/bash
#PBS -P Entropy
#PBS -q serial
#PBS -l select=1:ncpus=1:mem=2gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -N EntropyRun
#PBS -m bea
#PBS -M e1398082@u.nus.edu

cd ${PBS_O_WORKDIR}

# 1. Load shared C/system dependencies
source /app1/ebenv Python-3.10.4

# 2. Prevent the cluster's older SciPy modules from overriding your venv
unset PYTHONPATH

# 3. Activate your virtual environment
source ${HOME}/myenv/bin/activate

# 4. Set MOSEK license path
export MOSEKLM_LICENSE_FILE="${HOME}/mosek/mosek.lic"

# 5. Run the code using your venv interpreter
${HOME}/myenv/bin/python3 run_cluster.py 

exit $?
